{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync/incremental",
      "schedule": "*/5 1-10 * * 1-5"
    },
    {
      "path": "/api/cron/sync/heavy",
      "schedule": "*/30 1-11 * * 1-5"
    },
    {
      "path": "/api/cron/sync/full",
      "schedule": "0 0,5,11,17 * * *"
    },
    {
      "path": "/api/cron/daily-machine-output",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/daily-machine-output-email",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/auto-doc-creation",
      "schedule": "10 9 * * *"
    },
    {
      "path": "/api/cron/sara-wip-sync",
      "schedule": "0 1,4,7,10,13 * * *"
    },
    {
      "path": "/api/sara/wip-sync",
      "schedule": "0,30 0-13 * * *"
    },
    {
      "path": "/api/cron/sara-process-gen",
      "schedule": "50 9 * * *"
    },
    {
      "path": "/api/cron/line-daily-po-pr",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/sync/full-orders",
      "schedule": "0 1-11 * * 1-5"
    }
  ]
}
