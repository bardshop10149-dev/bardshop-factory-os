{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync/incremental",
      "schedule": "*/5 1-10 * * 1-5"
    },
    {
      "path": "/api/cron/sync/heavy",
      "schedule": "*/30 1-11 * * 1-5"
    },
    {
      "path": "/api/cron/sync/full",
      "schedule": "0 0,5,11,17 * * *"
    }
  ]
}
